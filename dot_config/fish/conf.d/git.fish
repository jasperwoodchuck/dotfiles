abbr -a ga  "git add"
abbr -a gaa "git add ."

abbr -a gb "git branch"

abbr -a gw "git status"

abbr -a gc  "git commit"
abbr -a gca "git commit --amend"

abbr -a gl  "git log"
abbr -a glo "git log --oneline"

abbr -a gp "git push"

abbr -a gr  "git rebase"
